# GOD-code provider environment examples.
#
# Default local mode. This is equivalent to leaving GOD_CODE_PROVIDER unset.
GOD_CODE_PROVIDER=fake

# OpenAI-compatible Chat Completions example.
# Do not put the API key value in GOD_CODE_API_KEY_ENV. Put the name of the
# environment variable that contains the key.
#
# export GOD_CODE_PROVIDER=openai
# export GOD_CODE_MODEL=gpt-4.1-mini
# export GOD_CODE_API_KEY_ENV=OPENAI_API_KEY
# export OPENAI_API_KEY=replace-with-your-real-key
# export GOD_CODE_PROVIDER_TIMEOUT_S=30
# export GOD_CODE_PROVIDER_MAX_RETRIES=2
# export GOD_CODE_PROVIDER_RETRY_BASE_DELAY_MS=250
# export GOD_CODE_PROVIDER_RETRY_MAX_DELAY_MS=2000
#
# Optional provider-reported usage budget guard. These limits only apply when
# the provider returns usage metadata; REQUIRE_USAGE=true makes missing usage a
# provider error.
#
# export GOD_CODE_PROVIDER_MAX_INPUT_TOKENS=100000
# export GOD_CODE_PROVIDER_MAX_OUTPUT_TOKENS=8192
# export GOD_CODE_PROVIDER_MAX_TOTAL_TOKENS=120000
# export GOD_CODE_PROVIDER_REQUIRE_USAGE=false
#
# Optional local provider request throttle. This is process-local, disabled by
# default, and does not call provider quota or billing APIs.
#
# export GOD_CODE_PROVIDER_RATE_LIMIT_ENABLED=false
# export GOD_CODE_PROVIDER_RATE_LIMIT_STRATEGY=fail-fast
# export GOD_CODE_PROVIDER_RATE_LIMIT_REQUESTS_PER_MINUTE=60
# export GOD_CODE_PROVIDER_RATE_LIMIT_MIN_INTERVAL_MS=0
# export GOD_CODE_PROVIDER_RATE_LIMIT_MAX_WAIT_MS=0
# export GOD_CODE_PROVIDER_RATE_LIMIT_SCOPE=process
#
# Optional provider-native parallel tool calls. This is disabled by default.
# When enabled, compatible provider responses with multiple native tool calls
# are normalized into Python ToolCallBatchAction; execution safety still comes
# from the ToolScheduler policy.
#
# export GOD_CODE_PROVIDER_PARALLEL_TOOL_CALLS=false
#
# Optional system prompt customization. The built-in system prompt is enabled by
# default and stays inside ModelRequest; it is not written as transcript history.
# GOD_CODE_SYSTEM_PROMPT and GOD_CODE_SYSTEM_PROMPT_FILE are mutually exclusive.
#
# export GOD_CODE_SYSTEM_PROMPT_ENABLED=true
# export GOD_CODE_SYSTEM_PROMPT='Use concise, tool-grounded final answers.'
# export GOD_CODE_SYSTEM_PROMPT_EXTRA='Prefer small, reviewable edits.'
# export GOD_CODE_SYSTEM_PROMPT_FILE=/path/to/system-prompt.txt
#
# Optional local token budget estimate. This is prompt-layer metadata computed
# before provider calls; it is approximate and separate from provider-reported
# usage / billing guards.
#
# export GOD_CODE_TOKEN_BUDGET_ENABLED=true
# export GOD_CODE_TOKEN_BUDGET_MAX_INPUT_TOKENS=120000
# export GOD_CODE_TOKEN_BUDGET_CHARS_PER_TOKEN=4
# export GOD_CODE_TOKEN_BUDGET_INCLUDE_TOOL_SCHEMAS=true
# export GOD_CODE_TOKEN_BUDGET_INCLUDE_PROVIDER_CONTEXT=true
#
# Optional summary-oriented context compaction. This stays inside Python
# PromptBuilder -> CompactionStrategy and does not rewrite transcript history.
#
# export GOD_CODE_CONTEXT_COMPACTION=summary
# export GOD_CODE_CONTEXT_SUMMARY_MAX_CHARS=24000
# export GOD_CODE_CONTEXT_SUMMARY_KEEP_RECENT_MESSAGES=12
# export GOD_CODE_CONTEXT_SUMMARY_OUTPUT_MAX_CHARS=4000
# export GOD_CODE_CONTEXT_SUMMARY_INCLUDE_TOOL_RESULTS=true
#
# Optional local prompt injection guard. The default mode is report-only and
# keeps sanitized findings inside Python ModelRequest metadata.
#
# export GOD_CODE_PROMPT_INJECTION_GUARD_ENABLED=true
# export GOD_CODE_PROMPT_INJECTION_GUARD_ACTION=report
# export GOD_CODE_PROMPT_INJECTION_GUARD_INCLUDE_SYSTEM_PROMPT=false
# export GOD_CODE_PROMPT_INJECTION_GUARD_INCLUDE_PROVIDER_CONTEXT=true
# export GOD_CODE_PROMPT_INJECTION_GUARD_INCLUDE_TOOL_RESULTS=true
#
# Optional fallback chain. Each fallback has its own provider/model/API-key env,
# timeout, and retry policy. Fallbacks are attempted only after the current
# provider exhausts retryable failures.
#
# export GOD_CODE_PROVIDER_FALLBACKS='[{"provider":"openai-compatible","model":"fallback-model","api_key_env":"FALLBACK_OPENAI_COMPAT_KEY","base_url":"https://fallback.example.invalid/v1","timeout_s":30,"max_retries":1,"retry_base_delay_ms":250,"retry_max_delay_ms":2000}]'
# export FALLBACK_OPENAI_COMPAT_KEY=replace-with-your-real-key
#
# After setting real provider variables, explicitly verify connectivity with:
# god-code doctor provider-health

# Custom OpenAI-compatible Chat Completions endpoint.
#
# export GOD_CODE_PROVIDER=openai-compatible
# export GOD_CODE_MODEL=custom-model
# export GOD_CODE_API_KEY_ENV=CUSTOM_OPENAI_COMPAT_KEY
# export CUSTOM_OPENAI_COMPAT_KEY=replace-with-your-real-key
# export GOD_CODE_BASE_URL=https://example.invalid/v1

# Local OpenAI-compatible Chat Completions endpoint without an API key.
# This is useful for local/sandbox servers that expose /v1/chat/completions.
#
# export GOD_CODE_PROVIDER=local-openai-compatible
# export GOD_CODE_MODEL=local-model
# export GOD_CODE_BASE_URL=http://127.0.0.1:11434/v1
#
# Optional local model discovery. These commands query the local
# OpenAI-compatible /models endpoint explicitly; they do not start daemons or
# rewrite GOD_CODE_MODEL.
#
# export GOD_CODE_LOCAL_PROVIDER_MODELS_URL=http://127.0.0.1:11434/v1/models
# export GOD_CODE_LOCAL_PROVIDER_MODELS_TIMEOUT_S=30
# export GOD_CODE_LOCAL_PROVIDER_MODELS_MAX_RESULTS=200
#
# god-code provider local-models list --json
# god-code provider local-models list --require-configured-model --json

# Optional local model pull command. This runs only through
# `god-code provider local-models pull ...`; ordinary run/repl/doctor and
# local-models list will not pull models automatically.
#
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PULL_ENABLED=false
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PULL_COMMAND=ollama
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PULL_ARGS_TEMPLATE='["pull","{model}"]'
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PULL_CWD=/path/to/workspace
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PULL_TIMEOUT_MS=600000
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PULL_LOG_FILE=.god-code/local-provider-model-pull.log
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PULL_ENV_ALLOWLIST=PATH,HOME
#
# god-code provider local-models pull local-model --dry-run --json
# god-code provider local-models pull local-model --yes --json

# Optional local model remove command. This runs only through
# `god-code provider local-models remove ...`; it does not directly delete
# model files or prune caches.
#
# export GOD_CODE_LOCAL_PROVIDER_MODEL_REMOVE_ENABLED=false
# export GOD_CODE_LOCAL_PROVIDER_MODEL_REMOVE_COMMAND=ollama
# export GOD_CODE_LOCAL_PROVIDER_MODEL_REMOVE_ARGS_TEMPLATE='["rm","{model}"]'
# export GOD_CODE_LOCAL_PROVIDER_MODEL_REMOVE_CWD=/path/to/workspace
# export GOD_CODE_LOCAL_PROVIDER_MODEL_REMOVE_TIMEOUT_MS=600000
# export GOD_CODE_LOCAL_PROVIDER_MODEL_REMOVE_LOG_FILE=.god-code/local-provider-model-remove.log
# export GOD_CODE_LOCAL_PROVIDER_MODEL_REMOVE_ENV_ALLOWLIST=PATH,HOME
#
# god-code provider local-models remove local-model --dry-run --json
# god-code provider local-models remove local-model --yes --json

# Optional local model/cache prune command. This runs only through
# `god-code provider local-models prune ...`; it does not directly delete model
# files, does not run automatically, and confirmed execution requires the target
# to be allowlisted.
#
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PRUNE_ENABLED=false
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PRUNE_COMMAND=ollama
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PRUNE_ARGS_TEMPLATE='["prune","--target","{target}"]'
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PRUNE_CWD=/path/to/workspace
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PRUNE_TIMEOUT_MS=600000
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PRUNE_LOG_FILE=.god-code/local-provider-model-prune.log
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PRUNE_ENV_ALLOWLIST=PATH,HOME
# export GOD_CODE_LOCAL_PROVIDER_MODEL_PRUNE_ALLOWED_TARGETS=unused,dangling
#
# god-code provider local-models prune --target unused --dry-run --json
# god-code provider local-models prune --target unused --yes --json

# Optional local provider daemon lifecycle. These commands are only used by
# `god-code provider local-daemon ...`; ordinary run/repl/doctor will not start
# a daemon automatically.
#
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_ENABLED=false
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_COMMAND=ollama
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_ARGS='["serve"]'
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_CWD=/path/to/workspace
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_READY_URL=http://127.0.0.1:11434/v1/models
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_READY_TIMEOUT_MS=15000
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_PID_FILE=.god-code/local-provider-daemon.json
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_LOG_FILE=.god-code/local-provider-daemon.log
# export GOD_CODE_LOCAL_PROVIDER_DAEMON_ENV_ALLOWLIST=PATH,HOME
#
# god-code provider local-daemon status --json
# god-code provider local-daemon start --dry-run --json
# god-code provider local-daemon stop --dry-run --json

# Local OpenAI-compatible endpoint with an optional bearer token.
#
# export GOD_CODE_PROVIDER=local-openai-compatible
# export GOD_CODE_MODEL=local-model
# export GOD_CODE_API_KEY_ENV=LOCAL_OPENAI_COMPAT_KEY
# export LOCAL_OPENAI_COMPAT_KEY=replace-with-your-local-token
# export GOD_CODE_BASE_URL=http://127.0.0.1:8000/v1

# OpenAI Responses API example.
#
# export GOD_CODE_PROVIDER=openai-responses
# export GOD_CODE_MODEL=gpt-4.1-mini
# export GOD_CODE_API_KEY_ENV=OPENAI_API_KEY

# Custom OpenAI-compatible Responses endpoint.
#
# export GOD_CODE_PROVIDER=openai-compatible-responses
# export GOD_CODE_MODEL=custom-responses-model
# export GOD_CODE_API_KEY_ENV=CUSTOM_RESPONSES_KEY
# export CUSTOM_RESPONSES_KEY=replace-with-your-real-key
# export GOD_CODE_BASE_URL=https://example.invalid/v1

# Anthropic Messages API example.
#
# export GOD_CODE_PROVIDER=anthropic
# export GOD_CODE_MODEL=claude-sonnet-4-5
# export GOD_CODE_API_KEY_ENV=ANTHROPIC_API_KEY
# export ANTHROPIC_API_KEY=replace-with-your-real-key
# export GOD_CODE_ANTHROPIC_VERSION=2023-06-01

# Custom Anthropic-compatible Messages endpoint.
#
# export GOD_CODE_PROVIDER=anthropic-compatible
# export GOD_CODE_MODEL=custom-claude-compatible-model
# export GOD_CODE_API_KEY_ENV=CUSTOM_ANTHROPIC_KEY
# export CUSTOM_ANTHROPIC_KEY=replace-with-your-real-key
# export GOD_CODE_BASE_URL=https://example.invalid
