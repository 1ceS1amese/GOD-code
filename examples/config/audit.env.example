# GOD-code host tool audit examples.
#
# Audit persistence is disabled when GOD_CODE_AUDIT_FILE is unset.
# Relative paths resolve from the current working directory.
GOD_CODE_AUDIT_FILE=.god-code/audit/tools.jsonl

# Current generation size in bytes. Default: 10485760 (10 MiB).
# When the next record would exceed the cap, the current file becomes .1.
GOD_CODE_AUDIT_MAX_BYTES=10485760

# Per-record append durability. Default: buffered.
# buffered: rely on close/kernel buffering; data: fdatasync; full: fsync.
# On POSIX, full also syncs the parent after current creation or rotation.
# Windows currently keeps full at file-only synchronization.
GOD_CODE_AUDIT_DURABILITY=buffered

# Optional comma-separated structured key suffixes to redact in addition to
# the built-in authorization/password/secret/token/api-key/private-key/cookie rules.
# Values are key names, never secret values. Maximum: 64 entries, 128 normalized chars each.
GOD_CODE_AUDIT_REDACT_KEYS=credential,access_key,passphrase

# Audit records may contain paths, commands, tool inputs, and results.
# Common structured credential keys are written as [REDACTED].
# Free-form command, message, and output strings are not secret-scanned.
# Keep the destination private and do not commit it to source control.
# Existing symbolic links and hard-linked/non-regular targets are rejected.
# Multiple sinks in one Node.js process coordinate by resolved absolute path.
# Do not run multiple processes against the same audit file.
# POSIX current and rotated files are normalized to owner-only mode 0600.
# Validate current path readiness without creating it:
# god-code audit inspect-path --json
# On Windows, restrict the destination with filesystem ACLs.
#
# export GOD_CODE_AUDIT_FILE=/tmp/god-code-tools.jsonl
