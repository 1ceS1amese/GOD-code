# GOD-code transcript directory examples.
#
# If unset, TS Host resolves transcript history to:
#   <cwd>/.god-code/transcripts
#
# Use a relative path to keep transcript files inside the current workspace.
GOD_CODE_TRANSCRIPT_DIR=.god-code/transcripts

# Use an absolute path if you want all runs to share one local history folder.
#
# export GOD_CODE_TRANSCRIPT_DIR=/tmp/god-code-transcripts
